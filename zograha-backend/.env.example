# ---- Database (PostgreSQL: Neon / Supabase / Vercel Postgres) ----
# Pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://user:password@host/zograha?sslmode=require"
# Direct (non-pooled) connection string (used by prisma migrate)
DIRECT_URL="postgresql://user:password@host/zograha?sslmode=require"

# ---- Security ----
# Long random string. Sent as header `x-admin-key` for admin/write endpoints.
ADMIN_API_KEY="change-me-to-a-long-random-string"
# Random salt used to hash IPs for rate limiting
IP_HASH_SALT="change-me-too"
# Comma separated list of frontend origins allowed by CORS
FRONTEND_ORIGINS="http://localhost:3000,http://localhost:5173,https://www.zograha.com,https://zograha.com"

# ---- Email notifications (optional, https://resend.com) ----
RESEND_API_KEY=""
NOTIFY_EMAIL="hr@zograha.com,info@zograha.com"
MAIL_FROM="Zograha Website <onboarding@resend.dev>"

# ---- Resume uploads (optional, Vercel Blob) ----
BLOB_READ_WRITE_TOKEN=""

# ---- Public company info served by GET /api/settings ----
COMPANY_NAME="Zograha Technologies"
COMPANY_PHONE="+910000000000"
COMPANY_EMAIL="info@zograha.com"
COMPANY_ADDRESS="Your office address, Tamil Nadu, India"
WHATSAPP_NUMBER="910000000000"
GOOGLE_MAPS_EMBED_URL=""
SITE_URL="https://www.zograha.com"
SOCIAL_LINKEDIN=""
SOCIAL_INSTAGRAM=""
SOCIAL_FACEBOOK=""
SOCIAL_X=""
SOCIAL_YOUTUBE=""
